EBS_ENV=production
EBS_PUBLIC_URL=https://thebazaar-twitch.online
EBS_API_URL=https://api.thebazaar-twitch.online
EBS_DRY_RUN=1
EBS_DATABASE_PATH=/app/data/ebs.sqlite3

EBS_MAIL_PROVIDER=smtp
EBS_SMTP_HOST=smtp.example.com
EBS_SMTP_PORT=587
EBS_SMTP_USERNAME=replace-with-smtp-user
EBS_SMTP_PASSWORD=replace-with-smtp-password
EBS_SMTP_FROM=noreply@example.com
EBS_SMTP_STARTTLS=1
EBS_SMTP_SSL=0

# To avoid outbound SMTP blocks, use Yandex Cloud Postbox over HTTPS:
# EBS_MAIL_PROVIDER=yandex_postbox
EBS_YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net/v2/email/outbound-emails
EBS_YANDEX_POSTBOX_FROM=noreply@example.com
EBS_YANDEX_POSTBOX_REGION=ru-central1
EBS_YANDEX_POSTBOX_IAM_TOKEN=
EBS_YANDEX_POSTBOX_ACCESS_KEY_ID=
EBS_YANDEX_POSTBOX_SECRET_ACCESS_KEY=

TWITCH_EXTENSION_CLIENT_ID=4cezwcccyflzbsbtyblw77j63ud411
TWITCH_EXTENSION_OWNER_ID=
TWITCH_EXTENSION_SECRET_BASE64=
TWITCH_EXTENSION_VERSION=0.0.1
EBS_TWITCH_GQL_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko

# Registration database is preferred in production.
# COMPANION_TOKENS_JSON remains available as a manual fallback.
# COMPANION_TOKENS_JSON={"123456789":"replace-with-long-random-token"}
COMPANION_TOKENS_JSON={"dev-channel":"replace-with-long-random-token"}

EBS_CORS_ORIGINS=https://thebazaar-twitch.online,https://api.thebazaar-twitch.online,https://extension-files.twitch.tv,https://*.twitch.tv,https://*.twitch.tech
EBS_MAX_PAYLOAD_BYTES=5000
EBS_MIN_SEND_INTERVAL_SECONDS=1.0
EBS_JWT_TTL_SECONDS=120
