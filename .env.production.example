EBS_ENV=production
EBS_PUBLIC_URL=https://api.thebazaar-twitch.online
EBS_DRY_RUN=1

TWITCH_EXTENSION_CLIENT_ID=4cezwcccyflzbsbtyblw77j63ud411
TWITCH_EXTENSION_OWNER_ID=
TWITCH_EXTENSION_SECRET_BASE64=
TWITCH_EXTENSION_VERSION=0.0.1

# Prefer COMPANION_TOKENS_JSON in production so multiple broadcasters can be configured.
# Example:
# COMPANION_TOKENS_JSON={"123456789":"replace-with-long-random-token"}
COMPANION_TOKENS_JSON={"dev-channel":"replace-with-long-random-token"}

EBS_CORS_ORIGINS=https://api.thebazaar-twitch.online,https://extension-files.twitch.tv,https://*.twitch.tv,https://*.twitch.tech
EBS_MAX_PAYLOAD_BYTES=5000
EBS_MIN_SEND_INTERVAL_SECONDS=1.0
EBS_JWT_TTL_SECONDS=120
