# Local development defaults.
# Copy this file to .env and fill Twitch values when you are ready to leave dry-run mode.

EBS_ENV=development
EBS_PUBLIC_URL=http://127.0.0.1:8000
EBS_API_URL=http://127.0.0.1:8000
EBS_DRY_RUN=1
EBS_DATABASE_PATH=data/ebs.sqlite3

# Optional SMTP settings. When configured, registration emails credentials to streamers.
EBS_MAIL_PROVIDER=smtp
EBS_SMTP_HOST=
EBS_SMTP_PORT=587
EBS_SMTP_USERNAME=
EBS_SMTP_PASSWORD=
EBS_SMTP_FROM=
EBS_SMTP_STARTTLS=1
EBS_SMTP_SSL=0

# Optional Yandex Cloud Postbox HTTPS sender. Use EBS_MAIL_PROVIDER=yandex_postbox.
EBS_YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net/v2/email/outbound-emails
EBS_YANDEX_POSTBOX_FROM=
EBS_YANDEX_POSTBOX_REGION=ru-central1
EBS_YANDEX_POSTBOX_IAM_TOKEN=
EBS_YANDEX_POSTBOX_ACCESS_KEY_ID=
EBS_YANDEX_POSTBOX_SECRET_ACCESS_KEY=

# Twitch Extension settings.
# Keep the real secret only on the EBS server, never in extension frontend code.
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_OWNER_ID=
TWITCH_EXTENSION_SECRET_BASE64=
TWITCH_EXTENSION_VERSION=0.0.1
EBS_TWITCH_GQL_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko

# Companion ingest auth.
# The registration database is preferred. These env tokens are kept for local fallback.
COMPANION_CHANNEL_ID=dev-channel
COMPANION_SHARED_TOKEN=dev-companion-token

# Runtime limits.
EBS_MAX_PAYLOAD_BYTES=5000
EBS_MIN_SEND_INTERVAL_SECONDS=1.0
EBS_JWT_TTL_SECONDS=120
